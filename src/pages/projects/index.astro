---
import { Image } from 'astro:assets'

import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import KeyIcon from '@/assets/icons/key.svg'

const headings = [
  { depth: 2, slug: 'programs', text: 'Projects' },
  { depth: 2, slug: 'gpg-signature', text: 'GPG Signature' }
]
---

<PageLayout title='Projects' {headings} view>
  <p>Github Activities:</p>
  <p>
    <Image
      src='https://ghchart.rshah.org/659eb9/CenTr1X'
      alt='github activities'
      inferSize
      loading='lazy'
    />
  </p>
  <p>
    这里整理一些与本站相关的项目、代码和后续可能公开的研究工具。目前主要维护博客本身。
  </p>

  <h2 id='programs'>Projects</h2>
  <ProjectSection
    projects={[
      {
        name: '捕风集',
        description: '基于Astro构建的个人博客，记录技术、安全与人文社科方向的随笔。',
        links: [
          { type: 'github', href: 'https://github.com/CenTr1X/blog-astro' },
          { type: 'site', href: 'https://centrix.top/' }
        ]
      }
    ]}
  />

  <h2 id='gpg-signature'>GPG Signature</h2>
  <p>
    如果后续公开需要校验来源的文件或工具，可通过GPG签名确认真实性。当前密钥信息如有更新，将在此处同步。
  </p>
  <Button href='https://github.com/CenTr1X' title='GitHub profile' target='_blank'>
    <Icon class='size-5' name='github' slot='before' />
  </Button>
  <Button href='https://keys.openpgp.org/' title='OpenPGP key server' target='_blank'>
    <KeyIcon class='size-5' slot='before' />
  </Button>
</PageLayout>

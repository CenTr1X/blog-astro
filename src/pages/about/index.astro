---
import { Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import { calculateSiteAge, getTotalWords } from '@/components/home/utils'
import { getBlogCollection } from 'astro-pure/server'

const headings = [
  // { depth: 2, slug: 'hobbies', text: 'Hobbies' },
  // { depth: 2, slug: 'tools', text: 'Tools' },
  // { depth: 2, slug: 'social-networks', text: 'Social Networks' },
  // { depth: 2, slug: 'gossips', text: 'Gossips' },
  { depth: 2, slug: 'about-me', text: '关于我' },
  { depth: 2, slug: 'about-blog', text: '关于本站' }
]

const totalWords = await getTotalWords()

const allPosts = await getBlogCollection()
const totalPosts = allPosts.length
const siteAgeText = calculateSiteAge('2026-05-02')
---

<PageLayout title='About' {headings} comment>
  <h2 id='about-me'>关于我</h2>
  <ul>
    <li>业余安全研究，也写一点技术之外的东西</li>
    <li>工作之余找点有意思的话题写写。尝试写过很多次博客了，CMS、静态站也都用过，但每次都写不了几篇，希望这次能多写点。
    什么都知道一点，什么都不太通。Web和二进制等可能都会涉及，政治、历史、社科、读书笔记等内容也可能会写。</li>
  </ul>
  {/* about-blog */}
  <h2 id='about-blog'>关于本站</h2>
  <h3>站点历史</h3>
  <Timeline
    events={[
      {
        date: '2026-05-04',
        content:'发布首篇文章'
      },
      {
        date: '2026-05-02',
        content: '建站，公网可访问'
      }
    ]}
  />
  <h3>
    统计信息
  </h3>
  <ul>
    <li>Site Start Date: May 2, 2026</li>
    <li>Site Age: {siteAgeText}</li>
    <li>Posts: {totalPosts}</li>
    <li>Words: {totalWords}</li>
    <li>Views: <span id="vercount_value_site_pv">Loading</span></li>
    <li>Visitors: <span id="vercount_value_site_uv">Loading</span></li>
  </ul>
  <h3>
    建站工具链
  </h3>
  <ul>
    <li>Domain: <a href='https://cloud.tencent.com/' target='_blank'>腾讯云</a></li>
    <li>DNS & CDN: <a href='https://www.cloudflare.com/' target='_blank'>Cloudflare</a></li>
    <li>
      Framework & Theme: <a href='https://astro.build/' target='_blank'>Astro</a> + <a
        href='https://github.com/cworld1/astro-theme-pure'
        target='_blank'>Astro Theme Pure</a
      >
    </li>
    <li>
      Site hosting: <a href='https://vercel.com/' target='_blank'>Vercel</a>
    </li>
    <li>
      CI/CD: <a href='https://github.com/CenTr1X/blog-astro' target='_blank'>GitHub</a> + <a
        href='https://vercel.com/'
        target='_blank'>Vercel</a
      >
    </li>
    <li>Comment system: <a href='https://waline.js.org' target='_blank'>Waline</a></li>
    <li>
      Page Visits: <a href='https://console.neon.tech/' target='_blank'>Neon</a> +
      <a href='https://waline.js.org/' target='_blank'>Waline</a>
    </li>
    <li>
      Site Visits: <a href='https://www.vercount.one/' target='_blank'>Vercount</a> 
    </li>
  </ul>
</PageLayout>
